# ─── Environment Configuration ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Base URL of the application under test (staging / local / mock server)
APP_BASE_URL=http://localhost:3000

# Test account credentials (staging / sandbox environment only)
TEST_USERNAME=deepak@digitarmedia.com
TEST_PASSWORD=Noida@1234

# Browser mode: true = headless (CI), false = headed (local debug)
HEADLESS=false

# Default action / navigation timeout in milliseconds
DEFAULT_TIMEOUT=30000

# Adapter to use: "mock" (default, no real HTTP calls) | "official" (real authorized API)
NETWORKING_ADAPTER=mock

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=linkedin_db
DB_USER=root
DB_PASSWORD=your_password_here
DATABASE_URL=mysql://root:your_password_here@localhost:3306/linkedin_db
