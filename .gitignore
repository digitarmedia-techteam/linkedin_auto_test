# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ─── Logs & Debug Artifacts ───────────────────────────────────────────────────
logs/*
!logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Development & Scratch Work ──────────────────────────────────────────────
scratch/

# ─── Playwright & Test Artifacts ─────────────────────────────────────────────
playwright-report/
**/playwright-report/
test-results/
**/test-results/
reports/*.json
reports/*.xml
!reports/.gitkeep

# ─── Sensitive Session State & Screenshots ────────────────────────────────────
storage/auth.json
storage/*.json
!storage/.gitkeep
screenshots/*.png
screenshots/*.jpg
!screenshots/.gitkeep

# ─── Operating System & IDE ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
