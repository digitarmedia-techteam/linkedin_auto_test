# =============================================================================
# LinkedIn Automation Platform Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit the active .env file containing real credentials to Git.
# =============================================================================

# Server Configuration
PORT=3011
NODE_ENV=production
APP_BASE_URL=https://www.linkedin.com

# Playwright & Browser Settings
HEADLESS=true
DEFAULT_TIMEOUT=30000
NETWORKING_ADAPTER=mock

# Default LinkedIn Test/Admin Account (Optional bootstrap)
TEST_USERNAME=user@example.com
TEST_PASSWORD=YourSecurePasswordHere

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=linkedin_db
DB_USER=root
DB_PASSWORD=YourDatabasePasswordHere
DATABASE_URL=mysql://root:YourDatabasePasswordHere@127.0.0.1:3306/linkedin_db
